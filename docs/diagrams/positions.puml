@startuml
left to right direction
actor "HR-менеджер" as HR
actor "Администратор" as Admin

rectangle "Управление должностями" {
  usecase "Добавить должность" as UC1
  usecase "Проверить глобальную уникальность" as UC3
  usecase "Указать статус активности" as UC4
  usecase "Присоединить к подразделению" as UC5
  usecase "Проверить уникальность в подразделении" as UC6
  usecase "Прочитать список должностей (фильтры)" as UC7
  usecase "Прочитать подразделения глобально (сортировка/глубина)" as UC8
}

HR --> UC1
HR --> UC5
HR --> UC7
HR --> UC8
Admin --> UC1
Admin --> UC7

UC1 ..> UC3 : <<include>>
UC1 <.. UC4 : <<extend>>
UC5 ..> UC6 : <<include>>
@enduml